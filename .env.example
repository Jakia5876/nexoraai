# ============================================================
# NEXORAAI — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# 1. PUBLIC CLIENT-SIDE CREDENTIALS (Vite / Browser Safe)
# Only publishable variables prefixed with VITE_ are safe for frontend bundles
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# 2. PRIVATE SERVER-SIDE CREDENTIALS (NEVER expose to client frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Super Admin Initial Setup
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=your_secure_admin_password

# AI Provider API Keys
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...

# Official WhatsApp Cloud API / QR Gateway
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_API_KEY=EAAGm0...
WHATSAPP_WEBHOOK_VERIFY_TOKEN=nexora_verify_token_secure_992

# Payment Gateways (International & Bangladesh Local MFS)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
BKASH_APP_KEY=your_bkash_merchant_app_key
BKASH_APP_SECRET=your_bkash_merchant_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
NAGAD_API_KEY=your_nagad_merchant_api_key

# Transactional Email (SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_...
SMTP_FROM_EMAIL=notifications@nexoraai.com
